{
  "display_information": {
    "name": "Kill Switch Agent",
    "description": "Finds the feature flag breaking production and asks you before switching it off in Flagsmith.",
    "background_color": "#1b2559"
  },
  "features": {
    "bot_user": {
      "display_name": "Kill Switch Agent",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write", "channels:history", "groups:history", "app_mentions:read"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.channels", "message.groups", "app_mention"]
    },
    "interactivity": { "is_enabled": true },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
