# Copy this file to .env and fill it in. Never commit .env.

# true = try the code with no Flagsmith or Slack (flags in data/local-flags.json). Use false for the real demo.
LOCAL_TEST_MODE=false
PORT=3000

# --- Flagsmith ---
# Environment settings > Keys > Server-side SDK key (starts with ser.)
FLAGSMITH_SERVER_KEY=
# Environment settings > the environment's client-side key / ID (used in Admin API URLs)
FLAGSMITH_ENVIRONMENT_KEY=
# Organisation settings > API Keys > create one (Admin API). Keep secret.
FLAGSMITH_ADMIN_API_KEY=
# Project settings: the project's numeric ID
FLAGSMITH_PROJECT_ID=
FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1/
FLAGSMITH_REFRESH_SECONDS=5
WATCHED_FLAGS=new_checkout,new_search_banner

# --- Slack (optional; without it, approve from the dashboard) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
# Comma-separated Slack user IDs allowed to approve. Empty = anyone in the channel.
SLACK_APPROVER_IDS=
# Backup Approve buttons on the dashboard. Automatic: on when Slack is missing or down, off when Slack works.
# Set true only if you also want dashboard approval while Slack works.
ALLOW_DASHBOARD_APPROVAL=false

# --- Claude (optional; without it, a plain template explanation is used) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Agent tuning ---
AGENT_INTERVAL_SECONDS=10
AGENT_WINDOW_SECONDS=30
ERROR_RATE_THRESHOLD=0.05
MIN_REQUESTS=40
MIN_REQUESTS_PER_GROUP=20
BLAME_RATIO=3
VERIFY_AFTER_SECONDS=30
SNOOZE_MINUTES=5
